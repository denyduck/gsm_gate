# Zkopíruj do .env (ten je v .gitignore, necommituje se) a uprav.
# docker compose .env automaticky načte a doplní do proměnných ${...} v docker-compose.yml.

# Vygeneruj vlastní, nikdy nesdílej ani nedávej do gitu:
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True jen pro lokální ladění - v produkci vždy False (odhaluje tracebacky/cesty/SQL).
DJANGO_DEBUG=False

# IP adresa (nebo hostname), přes kterou se brána otevírá v prohlížeči na LAN.
# Jediná hodnota k úpravě při změně IP (jiné RPi, DHCP apod.) - ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS i MKDOCS_BASE_URL (odkazy "Dokumentace" v appce) se z ní
# odvozují automaticky v docker-compose.yml, není potřeba upravovat je zvlášť
# a riskovat, že se rozjedou (viz incident s DisallowedHost v troubleshooting.md).
GATEWAY_HOST=10.10.10.234

# Retenční doby (dny) pro plánované mazání starých dat - viz
# manage.py prune_old_data / scripts/gsm-prune.timer.
RETENTION_DAYS_LOGS=90
RETENTION_DAYS_SIGNAL_HISTORY=30
