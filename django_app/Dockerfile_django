FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /usr/src/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends modemmanager \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_django.txt .
RUN pip install --no-cache-dir -r requirements_django.txt

COPY . .

CMD ["sh", "-c", "python manage.py collectstatic --noinput --clear && gunicorn gsm_gate.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-3}"]